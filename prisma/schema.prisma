// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// database
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Button {
  id     Int    @id @default(autoincrement())
  href   String
  label  String
  homeId Int
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
}

model Event {
  id             Int      @id @default(autoincrement())
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  content        String   @db.Text
  createdAt      DateTime @default(now())
  date           DateTime
  important      Boolean  @default(false)
  location       String?
  membersContent String?  @db.Text
  membersOnly    Boolean  @default(false)
  media          String?
  repeatId       String   @default(uuid())
  updatedAt      DateTime @updatedAt
  tag            Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  tagId          Int?
  time           String?
  title          String
}

model Group {
  id    Int    @id @default(autoincrement())
  name  String
  shoes String
  users User[]
}

model Home {
  id        Int      @id @default(autoincrement())
  buttons   Button[]
  content   String   @db.Text
  createdAt DateTime @default(now())
  imagePath String
  orderId   Int      @default(0)
  published Boolean  @default(true)
  title     String
  updatedAt DateTime @updatedAt
}

model Media {
  id          Int      @id @default(autoincrement())
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  createdAt   DateTime @default(now())
  date        DateTime
  imagePath   String
  membersPath String?
  path        String?
  tag         Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  tagId       Int?
  title       String
  updatedAt   DateTime @updatedAt
}

model Menu {
  id          Int      @id @default(autoincrement())
  children    Menu[]   @relation("MenuToMenu")
  parent      Menu?    @relation("MenuToMenu", fields: [parentId], references: [id])
  contentPath String
  createdAt   DateTime @default(now())
  description String?
  orderId     Int      @default(0)
  parentId    Int?
  title       String
  updatedAt   DateTime @updatedAt
}

model News {
  id             Int      @id @default(autoincrement())
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  content        String   @db.Text
  createdAt      DateTime @default(now())
  date           DateTime
  isAnnouncement Boolean  @default(false)
  isPublished    Boolean  @default(false)
  media          String?
  slug           String   @unique
  title          String
  updatedAt      DateTime @updatedAt
}

model Page {
  id        Int      @id @default(autoincrement())
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  parts     Part[]
  createdAt DateTime @default(now())
  slug      String   @unique
  title     String
  updatedAt DateTime @updatedAt
}

model Part {
  id            Int      @id @default(autoincrement())
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId      String?
  content       String   @db.Text
  createdAt     DateTime @default(now())
  mediaLocation Int      @default(0)
  mediaPath     String?
  orderId       Int      @default(100)
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId        Int
  updatedAt     DateTime @updatedAt
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  color  String?
  events Event[]
  media  Media[]
}

model User {
  id        String    @id @default(cuid())
  firstName String?
  lastName  String?
  logtoId   String    @unique @default(cuid())
  email     String?
  role      RoleType?
  pages     Page[]
  groups    Group[]
  news      News[]
  parts     Part[]
  events    Event[]
  media     Media[]
}

// types
enum RoleType {
  ADMIN
  DANSER
  SCHRIJVER
}
